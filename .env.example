# Copy to .env in the target project. Never commit the populated .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= # Only for temporary credentials

FXMIND_S3_ENDPOINT=https://s3.example.com
FXMIND_S3_REGION=us-east-1
FXMIND_S3_BUCKET=project-assets
FXMIND_S3_FORCE_PATH_STYLE=true
FXMIND_S3_PREFIX=images
FXMIND_S3_PUBLIC_URL=https://cdn.example.com

# Production MySQL: selected only with environment="production"; always read-only.
# URL-encode special characters in username/password (e.g. @ becomes %40).
FXMIND_MYSQL_PRODUCTION_URL=
# Example: mysql://agent_readonly:password@db.example.com:3306/production
# Optional dev override; otherwise keep using dev/dev.cfg / server.cfg.
# FXMIND_MYSQL_URL=mysql://user:password@127.0.0.1:3306/development

# Optional Jev (TypeSafe AI) decision support.
# Never commit credentials. Copy these values into fxmind/.env.
# Disabled by default: original local classifier and memory retrieval are used.
FXMIND_JEV_ENABLED=false
FXMIND_JEV_API_KEY=
# Also allow the official variable TYPESAFE_API_KEY via process environment.
FXMIND_JEV_MIN_CONFIDENCE=0.75
FXMIND_JEV_TIMEOUT_MS=2500
# Additional opt-in: semantically prioritize up to three existing memory hits.
FXMIND_JEV_MEMORY_ENABLED=false
# Gate C automatic verified memory capture (independent Jev relevance threshold)
FXMIND_JEV_LEARN_MIN_CONFIDENCE=0.70
# Additional opt-in: Jev chooses between plausible READ-ONLY MCP tool suggestions.
FXMIND_JEV_TOOL_ROUTING_ENABLED=false
